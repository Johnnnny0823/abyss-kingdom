/* 深淵王國：雛型介面樣式（深色深淵 + 金色點綴）。正式美術完成後替換。 */

.root {
    flex-grow: 1;
    background-color: rgb(8, 11, 22);
    background-size: 100% 100%;
    color: rgb(226, 230, 242);
    font-size: 15px;
}

/* ───── 共用 ───── */

.panel {
    flex-shrink: 0;
    background-color: rgba(22, 29, 54, 0.92);
    border-width: 1px;
    border-color: rgb(46, 59, 102);
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 12px;
}

.panel-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(232, 196, 118);
    margin-bottom: 8px;
}

.section-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(232, 196, 118);
    margin: 4px 0 10px 4px;
}

.muted { color: rgb(138, 147, 176); font-size: 13px; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
.spacer { flex-grow: 1; }

.btn {
    background-color: rgb(42, 54, 92);
    color: rgb(226, 230, 242);
    border-width: 1px;
    border-color: rgb(70, 86, 140);
    border-radius: 7px;
    padding: 6px 14px;
    margin: 0 0 0 6px;
    font-size: 14px;
    -unity-font-style: bold;
    transition-duration: 0.12s;
}
.btn:hover { background-color: rgb(58, 72, 120); border-color: rgb(110, 130, 196); }
.btn:active { background-color: rgb(34, 44, 76); }
.btn:disabled { opacity: 0.45; }

.btn-primary {
    background-color: rgb(196, 152, 72);
    border-color: rgb(236, 198, 120);
    color: rgb(24, 18, 8);
}
.btn-primary:hover { background-color: rgb(222, 176, 92); border-color: rgb(250, 220, 150); }
.btn-primary:active { background-color: rgb(170, 128, 56); }

.btn-free {
    background-color: rgb(42, 132, 112);
    border-color: rgb(92, 204, 176);
    color: rgb(236, 255, 248);
}
.btn-free:hover { background-color: rgb(54, 160, 136); }

.btn-danger { border-color: rgb(150, 70, 80); color: rgb(240, 170, 176); }
.btn-danger:hover { background-color: rgb(90, 40, 50); }

.btn-small { padding: 3px 10px; font-size: 13px; }

/* 進度條 */
.progress {
    height: 10px;
    border-radius: 5px;
    background-color: rgb(14, 19, 38);
    border-width: 1px;
    border-color: rgb(40, 52, 90);
    margin: 8px 0 6px 0;
    overflow: hidden;
}
.progress-fill {
    height: 100%;
    border-radius: 5px;
    background-color: rgb(214, 170, 88);
}
.progress-fill.training { background-color: rgb(96, 168, 230); }

/* 資源小圖示 */
.res-icon {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-right: 6px;
    padding: 0;
}
.res-icon.small { width: 16px; height: 16px; border-radius: 8px; font-size: 9px; margin-right: 3px; }
.res-Wood { background-color: rgb(150, 104, 58); }
.res-Stone { background-color: rgb(118, 126, 142); }
.res-Food { background-color: rgb(92, 140, 52); }
.res-Crystal { background-color: rgb(56, 120, 200); }

.cost { flex-direction: row; align-items: center; margin-right: 10px; }
.cost-label { font-size: 13px; }
.cost-label.short { color: rgb(240, 120, 120); }

/* ───── 頂部列 ───── */

.topbar {
    flex-direction: row;
    align-items: center;
    height: 64px;
    padding: 0 20px;
    background-color: rgba(10, 14, 30, 0.95);
    border-bottom-width: 1px;
    border-color: rgb(60, 52, 36);
}
.brand { font-size: 24px; -unity-font-style: bold; color: rgb(236, 200, 124); letter-spacing: 3px; }
.brand-sub { font-size: 12px; color: rgb(138, 147, 176); margin-left: 10px; margin-top: 8px; }

.icon { margin-right: 6px; }
.icon-small { margin-right: 3px; }
.total-power { font-size: 14px; -unity-font-style: bold; color: rgb(236, 200, 124); }
.power-delta.small { font-size: 13px; margin: 0 6px 0 0; }

.res-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgb(20, 27, 50);
    border-width: 1px;
    border-color: rgb(46, 59, 102);
    border-radius: 16px;
    padding: 4px 12px 4px 5px;
    margin-left: 8px;
}
.res-amount { font-size: 15px; -unity-font-style: bold; }
.res-cap { font-size: 12px; color: rgb(138, 147, 176); margin-left: 3px; }
.res-amount.full { color: rgb(240, 150, 110); }

.player-chip { margin-left: 18px; align-items: flex-end; }
.player-name { font-size: 15px; -unity-font-style: bold; }

/* ───── 主畫面 ───── */

.main { flex-direction: row; flex-grow: 1; padding: 16px 20px; }
.left { flex-grow: 1; flex-shrink: 1; margin-right: 16px; }
.right { width: 400px; flex-shrink: 0; }

.building-grid { flex-direction: row; flex-wrap: wrap; }

.building-card {
    width: 246px;
    height: 162px;
    margin: 0 12px 12px 0;
    padding: 12px 14px;
    background-color: rgba(22, 29, 54, 0.92);
    border-width: 1px;
    border-color: rgb(46, 59, 102);
    border-radius: 10px;
    transition-duration: 0.15s;
}
.building-card:hover { border-color: rgb(140, 120, 80); background-color: rgba(28, 36, 66, 0.95); }
.building-card.upgrading { border-color: rgb(214, 170, 88); }

.building-name { font-size: 17px; -unity-font-style: bold; }
.level-badge {
    background-color: rgb(52, 44, 26);
    border-width: 1px;
    border-color: rgb(150, 118, 60);
    border-radius: 9px;
    color: rgb(240, 206, 136);
    font-size: 12px;
    -unity-font-style: bold;
    padding: 1px 8px;
    margin-left: 8px;
}
.building-desc { font-size: 12px; color: rgb(138, 147, 176); white-space: normal; margin: 6px 0 4px 0; height: 32px; }
.building-footer { flex-direction: row; align-items: center; }

/* 隊列 */
.queue-idle { color: rgb(138, 147, 176); font-size: 14px; }
.queue-title { font-size: 15px; -unity-font-style: bold; }
.queue-time { font-size: 13px; color: rgb(190, 198, 222); }

/* 兵種選擇 */
.troop-tabs { flex-direction: row; margin-bottom: 10px; }
.troop-tab {
    flex-grow: 1;
    flex-basis: 0;
    padding: 8px 6px;
    margin-right: 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(46, 59, 102);
    background-color: rgb(18, 24, 46);
    align-items: center;
}
.troop-tab:hover { border-color: rgb(110, 130, 196); }
.troop-tab.selected { border-color: rgb(214, 170, 88); background-color: rgb(40, 36, 30); }
.troop-tab-name { font-size: 15px; -unity-font-style: bold; }
.troop-tab-count { font-size: 12px; color: rgb(138, 147, 176); }

.count-slider .unity-base-slider__dragger { background-color: rgb(214, 170, 88); border-color: rgb(250, 220, 150); }
.count-slider .unity-base-slider__tracker { background-color: rgb(30, 40, 72); border-color: rgb(46, 59, 102); }

/* 道具列表 */
.item-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 0;
    border-bottom-width: 1px;
    border-color: rgb(34, 44, 78);
}
.item-name { flex-grow: 1; font-size: 14px; }
.item-count { font-size: 13px; color: rgb(232, 196, 118); width: 50px; -unity-text-align: middle-right; margin-right: 8px; }

/* ───── 登入畫面 ───── */

.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 6, 14, 0.72);
}
.login-card {
    width: 460px;
    padding: 34px 38px 28px 38px;
    background-color: rgba(18, 24, 46, 0.97);
    border-width: 1px;
    border-color: rgb(120, 98, 56);
    border-radius: 14px;
}
.login-title { font-size: 40px; -unity-font-style: bold; color: rgb(236, 200, 124); -unity-text-align: middle-center; letter-spacing: 8px; }
.login-sub { font-size: 14px; color: rgb(138, 147, 176); -unity-text-align: middle-center; margin-bottom: 24px; letter-spacing: 2px; }
.field-label { font-size: 13px; color: rgb(170, 178, 204); margin: 10px 0 4px 2px; }

.unity-text-field { margin: 0; }
.unity-text-field > .unity-base-text-field__input {
    background-color: rgb(10, 14, 30);
    border-color: rgb(52, 66, 112);
    border-radius: 6px;
    color: rgb(226, 230, 242);
    padding: 6px 8px;
    font-size: 14px;
}

.login-btn { margin: 22px 0 0 0; height: 44px; font-size: 17px; }
.login-dev { margin: 8px 0 0 0; }
.login-status { margin-top: 12px; -unity-text-align: middle-center; }

/* ───── 加速視窗 ───── */

.dialog {
    width: 440px;
    padding: 20px 22px;
    background-color: rgba(18, 24, 46, 0.98);
    border-width: 1px;
    border-color: rgb(120, 98, 56);
    border-radius: 12px;
}

/* ───── 通知 ───── */

.toasts {
    position: absolute;
    top: 76px;
    right: 20px;
    width: 340px;
    align-items: flex-end;
}
.toast {
    background-color: rgba(26, 40, 70, 0.96);
    border-left-width: 4px;
    border-color: rgb(96, 190, 160);
    border-radius: 6px;
    padding: 8px 14px;
    margin-bottom: 8px;
    font-size: 14px;
    white-space: normal;
}
.toast.error { border-color: rgb(220, 96, 96); background-color: rgba(60, 26, 34, 0.96); }

/* 捲軸：細、深色，隱藏上下箭頭 */
.unity-scroller--vertical { width: 8px; border-width: 0; background-color: rgba(0, 0, 0, 0); margin-left: 4px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-scroller .unity-base-slider__tracker { background-color: rgba(20, 27, 50, 0.6); border-width: 0; border-radius: 4px; }
.unity-scroller .unity-base-slider__dragger { background-color: rgb(64, 78, 126); border-width: 0; border-radius: 4px; }
.unity-scroller .unity-base-slider__dragger:hover { background-color: rgb(96, 112, 170); }
/* ───── 頁籤 ───── */
.tabs { flex-direction: row; margin: 0 0 10px 0; }
.tab {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(138, 147, 176);
    padding: 4px 14px 8px 4px;
    margin-right: 14px;
    border-bottom-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}
.tab:hover { color: rgb(226, 230, 242); }
.tab.selected { color: rgb(232, 196, 118); border-color: rgb(214, 170, 88); }

/* ───── 主將 ───── */
.hero-grid { flex-direction: row; flex-wrap: wrap; }
.hero-card {
    width: 372px;
    margin: 0 12px 12px 0;
    padding: 14px 16px;
    background-color: rgba(22, 29, 54, 0.92);
    border-width: 1px;
    border-left-width: 4px;
    border-color: rgb(46, 59, 102);
    border-radius: 10px;
}
.hero-name { font-size: 22px; -unity-font-style: bold; }
.hero-title { font-size: 13px; color: rgb(170, 178, 204); margin-top: 2px; }
.hero-bio { font-size: 12px; color: rgb(138, 147, 176); white-space: normal; margin: 6px 0 8px 0; -unity-font-style: italic; }
.grade-badge { font-size: 12px; -unity-font-style: bold; border-radius: 9px; padding: 1px 8px; margin-left: 10px; border-width: 1px; }
.stat { flex-grow: 1; flex-basis: 0; align-items: center; padding: 6px 0; margin-right: 6px; background-color: rgb(16, 22, 42); border-radius: 6px; }
.stat-value { font-size: 16px; -unity-font-style: bold; }
.stat-label { font-size: 11px; color: rgb(138, 147, 176); }
.exp-row { flex-direction: row; align-items: center; margin-top: 8px; }
.book-btn { flex-grow: 1; flex-basis: 0; margin: 8px 6px 0 0; }

.grade-Common { border-color: rgb(150, 150, 160); color: rgb(210, 210, 220); }
.grade-Uncommon { border-color: rgb(96, 170, 90); color: rgb(150, 220, 140); }
.grade-Rare { border-color: rgb(70, 130, 220); color: rgb(130, 180, 250); }
.grade-Epic { border-color: rgb(150, 90, 220); color: rgb(196, 150, 250); }
.grade-Legendary { border-color: rgb(220, 170, 70); color: rgb(250, 210, 120); }
.grade-Mythic { border-color: rgb(200, 50, 60); color: rgb(250, 120, 130); background-color: rgb(30, 8, 12); }

/* ───── 主將頁：選擇列、角色雛形、裝備格、戰力 ───── */
.hero-chip {
    width: 200px; padding: 8px 12px; margin-right: 10px;
    background-color: rgba(22, 29, 54, 0.92);
    border-width: 1px; border-left-width: 4px; border-color: rgb(46, 59, 102); border-radius: 8px;
}
.hero-chip:hover { background-color: rgba(30, 38, 70, 0.95); }
.hero-chip.selected { background-color: rgb(40, 36, 30); border-top-color: rgb(214, 170, 88); border-right-color: rgb(214, 170, 88); border-bottom-color: rgb(214, 170, 88); }
.hero-chip-name { font-size: 16px; -unity-font-style: bold; }
.hero-chip-power { font-size: 13px; color: rgb(232, 196, 118); }

.hero-detail { flex-direction: row; align-items: flex-start; }
.paperdoll { flex-direction: row; align-items: center; padding: 14px; margin-right: 14px; background-color: rgba(16, 21, 40, 0.92); border-radius: 12px; border-width: 1px; border-color: rgb(46, 59, 102); }
.slot-col { width: 104px; }
.gear-slot { height: 74px; margin: 5px 0; padding: 6px 8px; border-radius: 8px; border-width: 1px; border-color: rgb(52, 64, 104); background-color: rgb(12, 16, 32); justify-content: center; }
.gear-slot:hover { border-color: rgb(214, 170, 88); }
.gear-slot.filled { background-color: rgb(24, 30, 54); }
.slot-label { font-size: 11px; color: rgb(120, 128, 160); }
.slot-name { font-size: 14px; -unity-font-style: bold; white-space: normal; }

.portrait { width: 170px; height: 252px; margin: 0 12px; border-radius: 12px; border-width: 2px; background-color: rgb(10, 13, 28); align-items: center; overflow: hidden; }
.silhouette { position: absolute; top: 30px; align-items: center; opacity: 0.55; }
.sil-head { width: 64px; height: 64px; border-radius: 32px; background-color: rgb(52, 62, 100); }
.sil-body { width: 130px; height: 150px; margin-top: 8px; border-top-left-radius: 60px; border-top-right-radius: 60px; background-color: rgb(40, 50, 86); }
.portrait-glyph { position: absolute; top: 96px; font-size: 54px; -unity-font-style: bold; color: rgb(236, 200, 124); }
.portrait-troop { position: absolute; bottom: 10px; font-size: 12px; color: rgb(200, 206, 226); background-color: rgba(0, 0, 0, 0.5); border-radius: 8px; padding: 2px 10px; }

.hero-info { flex-grow: 1; padding: 14px 16px; background-color: rgba(22, 29, 54, 0.92); border-radius: 12px; border-width: 1px; border-color: rgb(46, 59, 102); }
.power-label { font-size: 13px; color: rgb(138, 147, 176); margin-right: 8px; }
.power-big { font-size: 30px; -unity-font-style: bold; color: rgb(236, 200, 124); }
.power-delta { font-size: 18px; -unity-font-style: bold; color: rgb(120, 220, 150); margin-left: 10px; opacity: 0; }
.power-delta.down { color: rgb(240, 120, 120); }
.hint { margin-top: 10px; white-space: normal; }

/* ───── 遠征頁 ───── */
.idle-box { flex-direction: row; align-items: center; padding: 6px 10px; border-radius: 8px; background-color: rgba(22, 29, 54, 0.92); border-width: 1px; border-color: rgb(46, 59, 102); }
.stage-path { flex-direction: row; align-items: center; margin: 6px 0 14px 0; }
.stage-node { width: 40px; height: 40px; border-radius: 20px; -unity-text-align: middle-center; font-size: 15px; -unity-font-style: bold; color: rgb(120, 128, 160); background-color: rgb(16, 21, 40); border-width: 2px; border-color: rgb(46, 59, 102); }
.stage-node.branch { border-color: rgb(96, 168, 230); }
.stage-node.boss { width: 48px; height: 48px; border-radius: 24px; border-color: rgb(200, 70, 80); }
.stage-node.cleared { background-color: rgb(120, 92, 40); color: rgb(255, 236, 190); border-color: rgb(214, 170, 88); }
.stage-node.current { color: rgb(255, 255, 255); border-color: rgb(236, 200, 124); background-color: rgb(52, 44, 26); }
.stage-link { width: 22px; height: 2px; background-color: rgb(46, 59, 102); }
.stage-tag { font-size: 12px; color: rgb(250, 200, 140); background-color: rgb(60, 36, 26); border-radius: 8px; padding: 1px 8px; margin-left: 10px; margin-bottom: 8px; }

.branch-col { flex-grow: 1; flex-basis: 0; margin-right: 10px; padding: 10px; background-color: rgb(14, 19, 38); border-radius: 8px; }
.enemy-row { flex-direction: row; align-items: center; padding: 4px 0; border-bottom-width: 1px; border-color: rgb(34, 44, 78); }
.enemy-name { width: 90px; font-size: 14px; -unity-font-style: bold; color: rgb(240, 170, 160); }
.team-power { margin-top: 8px; font-size: 13px; color: rgb(140, 210, 160); }
.team-power.weak { color: rgb(240, 140, 120); }

.assign-chip { padding: 6px 12px; margin: 8px 8px 0 0; border-radius: 14px; border-width: 1px; border-color: rgb(52, 64, 104); background-color: rgb(14, 19, 38); color: rgb(138, 147, 176); }
.assign-chip:hover { border-color: rgb(110, 130, 196); }
.assign-chip.on { color: rgb(255, 236, 190); border-color: rgb(214, 170, 88); background-color: rgb(52, 44, 26); }
.assign-chip.team2 { color: rgb(200, 226, 255); border-color: rgb(96, 168, 230); background-color: rgb(24, 40, 66); }

.result-banner { font-size: 22px; -unity-font-style: bold; color: rgb(236, 200, 124); margin-bottom: 6px; }
.result-banner.lose { color: rgb(240, 130, 130); }
.reward-line { font-size: 14px; color: rgb(150, 220, 170); white-space: normal; margin-bottom: 8px; }
.battle-log { padding: 8px 10px; margin: 4px 0 10px 0; background-color: rgb(10, 14, 28); border-radius: 6px; }
.log-line { font-size: 12px; color: rgb(190, 200, 228); }
.log-line.enemy { color: rgb(230, 160, 160); }

/* ───── 四境 ───── */
.tier-badge { font-size: 12px; -unity-font-style: bold; color: rgb(170, 178, 204); border-width: 1px; border-color: rgb(70, 86, 140); border-radius: 9px; padding: 1px 10px; margin-left: 10px; margin-bottom: 8px; }
.tier-badge.lit { color: rgb(250, 214, 140); border-color: rgb(214, 170, 88); background-color: rgb(52, 44, 26); }
.domain-row { flex-direction: row; align-items: center; padding: 6px 8px; margin-bottom: 6px; border-radius: 8px; background-color: rgb(16, 22, 42); border-width: 1px; border-color: rgb(34, 44, 78); }
.domain-row.mastered { border-color: rgb(150, 118, 60); background-color: rgb(32, 30, 30); }
.domain-glyph { width: 30px; height: 30px; border-radius: 15px; -unity-text-align: middle-center; font-size: 15px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-right: 10px; }
.domain-Power { background-color: rgb(196, 84, 60); }
.domain-Technique { background-color: rgb(130, 90, 200); }
.domain-Speed { background-color: rgb(40, 150, 140); }
.domain-Durability { background-color: rgb(90, 110, 150); }
.domain-name { font-size: 14px; -unity-font-style: bold; }
.domain-fill-Power { background-color: rgb(226, 110, 80); }
.domain-fill-Technique { background-color: rgb(160, 120, 230); }
.domain-fill-Speed { background-color: rgb(70, 190, 170); }
.domain-fill-Durability { background-color: rgb(120, 145, 190); }
.domain-done { font-size: 13px; -unity-font-style: bold; color: rgb(236, 200, 124); margin-left: 10px; }

/* ───── 五行陰陽 ───── */
.el-badge { font-size: 11px; -unity-font-style: bold; border-radius: 8px; padding: 1px 7px; margin-left: 8px; border-width: 1px; color: rgb(20, 20, 20); }
.el-badge.yin { background-color: rgba(0, 0, 0, 0); }
.el-Wood { background-color: rgb(96, 176, 96); border-color: rgb(96, 176, 96); }
.el-Fire { background-color: rgb(226, 96, 70); border-color: rgb(226, 96, 70); }
.el-Earth { background-color: rgb(198, 156, 80); border-color: rgb(198, 156, 80); }
.el-Metal { background-color: rgb(206, 208, 218); border-color: rgb(206, 208, 218); }
.el-Water { background-color: rgb(80, 146, 226); border-color: rgb(80, 146, 226); }
.el-badge.yin.el-Wood { color: rgb(130, 210, 130); }
.el-badge.yin.el-Fire { color: rgb(250, 130, 110); }
.el-badge.yin.el-Earth { color: rgb(226, 190, 120); }
.el-badge.yin.el-Metal { color: rgb(220, 222, 232); }
.el-badge.yin.el-Water { color: rgb(130, 180, 250); }
.syn-line { font-size: 12px; color: rgb(150, 220, 200); white-space: normal; margin-top: 4px; }
.syn-line.enemy { color: rgb(230, 170, 160); }

/* ───── 升星 ───── */
.star { font-size: 22px; margin-right: 2px; -unity-font-style: bold; }
.star-tier { font-size: 13px; color: rgb(200, 206, 226); margin-left: 8px; }

/* ───── 深淵地圖 ───── */
.map-page { flex-direction: row; flex-grow: 1; }
.map-scroll { flex-grow: 1; background-color: rgb(4, 6, 12); border-radius: 10px; border-width: 1px; border-color: rgb(40, 50, 86); margin-right: 12px; }
.map-canvas { background-color: rgb(5, 7, 14); }
.map-side { width: 250px; flex-shrink: 0; }
.map-info { margin-top: 8px; }
.map-node-label { position: absolute; width: 30px; height: 30px; -unity-text-align: middle-center; font-size: 14px; -unity-font-style: bold; color: rgb(250, 250, 255); }
.map-node-label.unknown { color: rgb(130, 140, 180); }

.map-view3d { flex-grow: 1; margin-right: 12px; border-radius: 10px; border-width: 1px; border-color: rgba(120, 140, 200, 0.25); background-color: rgba(0, 0, 0, 0); }

/* ───── 出征 ───── */
.march-box { margin-top: 10px; padding-top: 8px; border-top-width: 1px; border-color: rgb(46, 59, 102); }
.march-troop-name { width: 56px; font-size: 13px; }
.march-troop-count { width: 74px; font-size: 12px; color: rgb(170, 178, 204); -unity-text-align: middle-right; }

.march-box > * { flex-shrink: 0; }
